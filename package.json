{
  "name": "painel-projetos",
  "version": "0.1.0",
  "private": true,
  "description": "Painel interno de gestão de projetos da KBO Soluções",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --config vite.config.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build --config vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:prod": "node dist/scripts/seed.js"
  },
  "dependencies": {
    "@alpinejs/csp": "^3.16.1",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^10.1.3",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.5.0",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
